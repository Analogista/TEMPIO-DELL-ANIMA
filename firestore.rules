rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true
        && (request.auth.token.email == 'analogistabrindisi@gmail.com'
          || request.auth.token.email == 'infantinograziamaria@gmail.com');
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function hasTimestamp(data, field) { return data.get(field, null) == request.time; }

    function validProfile(data) {
      return data.keys().hasAll(['nome', 'updatedAt'])
        && data.keys().hasOnly(['nome', 'email', 'telefono', 'eta', 'citta', 'puntoRottura', 'photoUrls', 'updatedAt'])
        && data.nome is string && data.nome.size() <= 100
        && data.get('email', '') is string && data.get('email', '') == request.auth.token.email
        && data.get('telefono', '') is string && data.get('telefono', '').size() <= 30
        && data.get('eta', '') is string && data.get('eta', '').size() <= 3
        && data.get('citta', '') is string && data.get('citta', '').size() <= 100
        && data.get('puntoRottura', '') is string && data.get('puntoRottura', '').size() <= 1000
        && data.get('photoUrls', []) is list && data.get('photoUrls', []).size() <= 2
        && hasTimestamp(data, 'updatedAt');
    }
    function validRune(data) {
      return data.keys().hasAll(['question', 'runeIds', 'timestamp'])
        && data.keys().hasOnly(['question', 'runeIds', 'runeNames', 'userName', 'userEmail', 'timestamp'])
        && data.question is string && data.question.size() <= 500
        && data.runeIds is list && data.runeIds.size() <= 24
        && data.get('runeNames', []) is list && data.get('runeNames', []).size() <= 24
        && data.get('userName', '') is string && data.get('userName', '').size() <= 100
        && data.get('userEmail', '') is string && data.get('userEmail', '') == request.auth.token.email
        && hasTimestamp(data, 'timestamp');
    }
    function validFlower(data) {
      return data.keys().hasAll(['flowerIds', 'timestamp'])
        && data.keys().hasOnly(['flowerIds', 'flowerNames', 'userName', 'userEmail', 'timestamp'])
        && data.flowerIds is list && data.flowerIds.size() <= 38
        && data.get('flowerNames', []) is list && data.get('flowerNames', []).size() <= 38
        && data.get('userName', '') is string && data.get('userName', '').size() <= 100
        && data.get('userEmail', '') is string && data.get('userEmail', '') == request.auth.token.email
        && hasTimestamp(data, 'timestamp');
    }
    function validConstellation(data) {
      return data.keys().hasAll(['characters', 'timestamp'])
        && data.keys().hasOnly(['characters', 'labels', 'screenshotUrl', 'userData', 'userName', 'userEmail', 'timestamp'])
        && data.characters is list && data.characters.size() <= 50
        && data.get('labels', []) is list && data.get('labels', []).size() <= 50
        && data.get('screenshotUrl', '') is string && data.get('screenshotUrl', '').size() <= 2000
        && data.get('userData', {}) is map
        && data.get('userName', '') is string && data.get('userName', '').size() <= 100
        && data.get('userEmail', '') is string && data.get('userEmail', '') == request.auth.token.email
        && hasTimestamp(data, 'timestamp');
    }
    function validCandidacy(data) {
      return data.keys().hasAll(['userId', 'nome', 'email', 'telefono', 'puntoRottura', 'radiceTempo', 'termometroUrgenza', 'obiettivoProfondo', 'pattoFiducia', 'rispettoSpazioSacro', 'portaleVisivo', 'message', 'photoUrls', 'status', 'createdAt'])
        && data.keys().hasOnly(['userId', 'nome', 'email', 'telefono', 'eta', 'citta', 'puntoRottura', 'radiceTempo', 'termometroUrgenza', 'obiettivoProfondo', 'pattoFiducia', 'rispettoSpazioSacro', 'portaleVisivo', 'message', 'photoUrls', 'status', 'createdAt'])
        && data.userId == request.auth.uid
        && data.nome is string && data.nome.size() <= 100
        && data.email is string && data.email == request.auth.token.email
        && data.telefono is string && data.telefono.size() <= 30
        && data.get('eta', '') is string && data.get('eta', '').size() <= 3
        && data.get('citta', '') is string && data.get('citta', '').size() <= 100
        && data.puntoRottura is string && data.puntoRottura.size() <= 1000
        && data.radiceTempo in ['meno_mese', 'qualche_mese', 'cronico']
        && data.termometroUrgenza is number && data.termometroUrgenza >= 1 && data.termometroUrgenza <= 10
        && data.obiettivoProfondo in ['sollievo', 'percorso']
        && data.pattoFiducia is bool && data.rispettoSpazioSacro is bool && data.portaleVisivo is bool
        && data.message is string && data.message.size() <= 2000
        && data.photoUrls is list && data.photoUrls.size() <= 2
        && data.status == 'pending' && hasTimestamp(data, 'createdAt');
    }
    function validGlobalReading(data) {
      return data.keys().hasAll(['type', 'userId', 'userEmail', 'timestamp'])
        && data.keys().hasOnly(['question','runeIds','runeNames','flowerIds','flowerNames','characters','labels','screenshotUrl','userData','userName','userEmail','timestamp','type','userId'])
        && data.type in ['rune', 'flower', 'constellation']
        && data.userId == request.auth.uid
        && data.userEmail == request.auth.token.email
        && (data.get('userName', null) == null || (data.userName is string && data.userName.size() <= 100))
        && data.get('question', '') is string && data.get('question', '').size() <= 500
        && data.get('runeIds', []) is list && data.get('runeIds', []).size() <= 24
        && data.get('runeNames', []) is list && data.get('runeNames', []).size() <= 24
        && data.get('flowerIds', []) is list && data.get('flowerIds', []).size() <= 38
        && data.get('flowerNames', []) is list && data.get('flowerNames', []).size() <= 38
        && data.get('characters', []) is list && data.get('characters', []).size() <= 50
        && data.get('labels', []) is list && data.get('labels', []).size() <= 50
        && data.get('screenshotUrl', '') is string && data.get('screenshotUrl', '').size() <= 2000
        && data.get('userData', {}) is map
        && data.get('timestamp', null) == request.time;
    }

    match /{document=**} { allow read, write: if false; }

    match /users/{userId} {
      match /profile/data {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validProfile(request.resource.data);
      }
      match /runeReadings/{readingId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(readingId) && validRune(request.resource.data);
      }
      match /flowerReadings/{readingId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(readingId) && validFlower(request.resource.data);
      }
      match /constellations/{constellationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(constellationId) && validConstellation(request.resource.data);
      }
      match /candidacies/{candidacyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(candidacyId) && validCandidacy(request.resource.data);
      }
    }

    match /candidacies/{candidacyId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && validCandidacy(request.resource.data);
      allow update, delete: if isAdmin();
    }
    match /allReadings/{readingId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(readingId) && validGlobalReading(request.resource.data);
      allow update, delete: if isAdmin();
    }
    match /admins/{adminId} { allow read: if isAdmin(); }
  }
}
