{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Unified profile information.",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "eta": {
          "type": "string"
        },
        "citta": {
          "type": "string"
        },
        "puntoRottura": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "telefono": {
          "type": "string"
        },
        "photoUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "nome",
        "updatedAt"
      ]
    },
    "RuneReading": {
      "title": "RuneReading",
      "description": "A record of a rune reading session.",
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "runeIds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "userName": {
          "type": "string"
        },
        "userEmail": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "runeNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "question",
        "runeIds",
        "timestamp"
      ]
    },
    "FlowerReading": {
      "title": "FlowerReading",
      "description": "A record of a Bach flower selection.",
      "type": "object",
      "properties": {
        "flowerIds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "userName": {
          "type": "string"
        },
        "userEmail": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "flowerNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "flowerIds",
        "timestamp"
      ]
    },
    "Constellation": {
      "title": "Constellation",
      "description": "A record of a family constellation session.",
      "type": "object",
      "properties": {
        "characters": {
          "type": "array"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "userName": {
          "type": "string"
        },
        "userEmail": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "userData": {
          "type": "object",
          "description": "Dati inseriti dall’utente nella sessione della costellazione."
        }
      },
      "required": [
        "characters",
        "timestamp"
      ]
    },
    "Candidacy": {
      "title": "Candidacy",
      "description": "A request for a healing path with an alchemical questionnaire.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "eta": {
          "type": "string"
        },
        "citta": {
          "type": "string"
        },
        "puntoRottura": {
          "type": "string"
        },
        "radiceTempo": {
          "type": "string"
        },
        "termometroUrgenza": {
          "type": "number"
        },
        "obiettivoProfondo": {
          "type": "string"
        },
        "pattoFiducia": {
          "type": "boolean"
        },
        "rispettoSpazioSacro": {
          "type": "boolean"
        },
        "portaleVisivo": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "photoUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "telefono": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "nome",
        "email",
        "telefono",
        "puntoRottura",
        "radiceTempo",
        "termometroUrgenza",
        "obiettivoProfondo",
        "pattoFiducia",
        "rispettoSpazioSacro",
        "portaleVisivo",
        "message",
        "photoUrls",
        "status",
        "createdAt"
      ]
    },
    "AdminReadState": {
      "title": "AdminReadState",
      "description": "Admin read/unread tracking state for received readings.",
      "type": "object",
      "properties": {
        "readBy": {
          "type": "string"
        },
        "readAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "readBy",
        "readAt"
      ]
    },
    "AkashicRequest": {
      "title": "AkashicRequest",
      "description": "A user request for an Akashic Records reading.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "birthDate": {
          "type": "string",
          "maxLength": 50
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "area": {
          "type": "string",
          "enum": [
            "Amore e relazioni",
            "Missione dell'anima",
            "Blocchi interiori",
            "Evoluzione personale",
            "Relazioni familiari"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "hope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "consentAccepted": {
          "type": "boolean"
        },
        "consentAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "nuova",
            "in_lavorazione",
            "completata"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "deletionRequested": {
          "type": "boolean",
          "description": "Set to false on creation; owner may transition from false to true to request data deletion."
        }
      },
      "required": [
        "ownerUid",
        "name",
        "email",
        "area",
        "question",
        "hope",
        "consentAccepted",
        "consentAt",
        "status",
        "createdAt",
        "deletionRequested"
      ]
    },
    "AkashicReading": {
      "title": "AkashicReading",
      "description": "Admin-authored 7-chapter Akashic Records reading linked 1:1 to an AkashicRequest.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "published": {
          "type": "boolean"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "chapters",
        "published",
        "publishedAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/profile/data": {
      "schema": "UserProfile",
      "description": "Unified profile of the user."
    },
    "/users/{userId}/runeReadings/{readingId}": {
      "schema": "RuneReading",
      "description": "User's rune reading history."
    },
    "/users/{userId}/flowerReadings/{readingId}": {
      "schema": "FlowerReading",
      "description": "User's flower remedy history."
    },
    "/users/{userId}/constellations/{constellationId}": {
      "schema": "Constellation",
      "description": "User's constellation sessions."
    },
    "/candidacies/{candidacyId}": {
      "schema": "Candidacy",
      "description": "Global candidacy applications for admin review."
    },
    "/allReadings/{readingId}": {
      "schema": "object",
      "description": "Global readings collection for admin review."
    },
    "/users/{userId}/candidacies/{candidacyId}": {
      "schema": "Candidacy",
      "description": "User's submitted candidature copy."
    },
    "/adminReadState/{readingId}": {
      "schema": "AdminReadState",
      "description": "Admin inbox read state keyed by allReadings document ID."
    },
    "/akashicRequests/{requestId}": {
      "schema": "AkashicRequest",
      "description": "User requests for Akashic Records readings."
    },
    "/akashicReadings/{requestId}": {
      "schema": "AkashicReading",
      "description": "7-chapter Akashic readings authored by admin for each request."
    }
  }
}
